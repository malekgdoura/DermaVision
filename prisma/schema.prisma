generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PATIENT
  MEDECIN
  ADMIN
}

model User {
  id         String   @id @default(cuid())
  nom        String
  prenom     String
  email      String   @unique
  telephone  String?
  motDePasse String
  role       Role     @default(PATIENT)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  images           Image[]
  skinAnalyses     SkinAnalysis[]   @relation("AnalysisPatient")
  reviewedAnalyses SkinAnalysis[]   @relation("AnalysisReviewer")
  reportVersions   ReportVersion[]
  recommendations  Recommendation[]
}

enum AnalysisStatus {
  PROCESSING // photo received, external API being called
  AI_DONE // AI result saved, waiting for a doctor's review
  IN_REVIEW // a doctor took the analysis and is correcting it / writing the report
  FAILED // the external API call failed
  VALIDATED // reviewed by a doctor, report published to the patient
}

// Private patient photo. The file itself lives in private storage; only its key is stored here.
model Image {
  id         String   @id @default(cuid())
  userId     String
  storageKey String   @unique
  mimeType   String
  size       Int // bytes
  createdAt  DateTime @default(now())

  user     User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  analysis SkinAnalysis?

  @@index([userId])
}

// One skin analysis request: one photo, one status, at most one AI result.
model SkinAnalysis {
  id         String         @id @default(cuid())
  userId     String
  imageId    String         @unique
  status     AnalysisStatus @default(PROCESSING)
  // Doctor who took the review. Set when the review starts; one doctor per analysis.
  reviewerId String?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  user     User           @relation("AnalysisPatient", fields: [userId], references: [id], onDelete: Cascade)
  reviewer User?          @relation("AnalysisReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  image    Image          @relation(fields: [imageId], references: [id], onDelete: Cascade)
  aiResult AiResult?
  review   MedicalReview?

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([reviewerId])
}

// Result returned by the external skin analysis API (Face++ for now).
model AiResult {
  id           String   @id @default(cuid())
  analysisId   String   @unique
  provider     String // e.g. "facepp"
  requestId    String? // provider request id, useful to trace a call
  rawResponse  Json // validated provider response, kept as is
  mappedResult Json // DermaVision format produced by server/skin-api/mapper.ts
  createdAt    DateTime @default(now())

  analysis SkinAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)
}

// Doctor's review of one analysis: corrected indicators, clinical notes and the report versions.
model MedicalReview {
  id                    String    @id @default(cuid())
  analysisId            String    @unique
  correctedResult       Json // DermaVision format (same shape as AiResult.mappedResult) after the doctor's corrections
  clinicalNotes         String? // private notes for the report, written by the doctor
  indicatorsValidatedAt DateTime
  publishedAt           DateTime? // set once, when the report is published to the patient
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  analysis SkinAnalysis    @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  versions ReportVersion[]
}

enum ReportStyle {
  SHORT
  DETAILED
  PATIENT_FRIENDLY
}

enum ReportVersionKind {
  AI_DRAFT // generated by the LLM, never shown to the patient as is
  DOCTOR_EDIT // saved by the doctor
  PUBLISHED // the version the patient sees (exactly one per published review)
}

// Every version of the report is kept: drafts, edits and the published text.
model ReportVersion {
  id        String            @id @default(cuid())
  reviewId  String
  number    Int // 1, 2, 3... per review
  kind      ReportVersionKind
  style     ReportStyle
  language  String // "en" | "fr"
  content   String            @db.Text
  model     String? // LLM model for AI drafts, e.g. "llama-3.3-70b-versatile"
  authorId  String // doctor who generated or saved this version
  createdAt DateTime          @default(now())

  review MedicalReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([reviewId, number])
  @@index([authorId])
}

// Care advice written and validated by a doctor, reused in reports (shared library of all doctors).
model Recommendation {
  id            String    @id @default(cuid())
  title         String
  content       String    @db.Text
  category      String // SkinIndicatorCategory or "general"
  // Signs this advice answers, e.g. ["acne", "blackhead"] or ["skin_type:oily"]. Used for suggestions.
  indicatorKeys String[]
  language      String // "en" | "fr"
  authorId      String
  archivedAt    DateTime? // archived instead of deleted: published reports may have used it
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([archivedAt, language])
  @@index([authorId])
}
