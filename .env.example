# Copy to .env and fill in the values.

# PostgreSQL
DATABASE_URL=postgresql://user:password@localhost:5432/dermavision

# Auth.js
AUTH_SECRET=
AUTH_URL=http://localhost:3000

# Private image storage (outside public/, never committed)
PRIVATE_STORAGE_DIR=./private-storage
MAX_UPLOAD_MB=2

# Module 1 - Face++ skin analysis
FACEPP_API_KEY=
FACEPP_API_SECRET=
FACEPP_BASE_URL=https://api-us.faceplusplus.com

# Module 2 - Groq report drafts (https://console.groq.com/keys)
GROQ_API_KEY=
# Optional. Default: llama-3.3-70b-versatile. Check https://console.groq.com/docs/models:
# if the model is decommissioned for your plan, set a current one (e.g. openai/gpt-oss-120b).
GROQ_MODEL=
# Optional. Default: https://api.groq.com/openai/v1
GROQ_BASE_URL=
